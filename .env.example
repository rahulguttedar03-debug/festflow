# CampusFlow Environment Variables (Supabase Backend)
# Copy this file to .env.local to connect to your real Supabase instance.
# If not provided, CampusFlow operates seamlessly using its built-in client-side persistence engine.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
